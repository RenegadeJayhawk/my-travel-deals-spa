    "@typescript-eslint/parser": "^8.71.2",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitest/coverage-v8": "^4.1.12",
    "@vitest/ui": "^4.1.12",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "^4.6.2",
